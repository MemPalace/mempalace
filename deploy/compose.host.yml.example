# name: <existing project name>
services:
  commonplace:
    image: commonplace:${COMMONPLACE_IMAGE_TAG:-local}
    build:
      context: ${COMMONPLACE_SOURCE_DIR:?Set COMMONPLACE_SOURCE_DIR to the source checkout}
      dockerfile: deploy/commonplace/Dockerfile
      args:
        COMMONPLACE_BUILD_COMMIT: ${COMMONPLACE_BUILD_COMMIT:-}
    init: true
    restart: unless-stopped
    ports:
      - "127.0.0.1:8765:8765"
    env_file:
      - ${COMMONPLACE_ENV_FILE:?Set COMMONPLACE_ENV_FILE to the operator environment file}
    environment:
      COMMONPLACE_DATA: /data
      COMMONPLACE_BASE_URL: ${COMMONPLACE_BASE_URL:-https://hub.example.com}
    volumes:
      - ${COMMONPLACE_DATA_DIR:?Set COMMONPLACE_DATA_DIR to the persistent data directory}:/data
    mem_limit: 3g
    stop_grace_period: 60s
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request; r = urllib.request.urlopen('http://127.0.0.1:8765/healthz', timeout=5); assert r.status == 200"
      interval: 30s
      timeout: 10s
      start_period: 30s
      retries: 3
