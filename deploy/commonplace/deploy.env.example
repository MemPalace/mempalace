# Copy to the operator directory as deploy.env, owned by root, mode 600.
# Literal KEY=VALUE data: no quotes, expansions or inline comments.
# Replace placeholders before use; environment settings take precedence.

# Required: loaded oneshot backup service with RemainAfterExit=no.
DEPLOY_BACKUP_UNIT=<host>-backup.service

# Optional: timeout in seconds, default 3600 (positive integer).
DEPLOY_BACKUP_TIMEOUT=3600

# Required: verification command; executable and arguments split on whitespace.
DEPLOY_BACKUP_CHECK_CMD=/usr/local/sbin/<host>-backup --check

# Required: command returning this deployment’s latest snapshot JSON.
DEPLOY_BACKUP_LATEST_CMD=/usr/local/sbin/<host>-backup --latest-json

# Optional: maximum snapshot age in seconds, default 7200 (60–86400).
DEPLOY_BACKUP_MAX_AGE=7200

# Optional: loopback application port, default 8765 (1–65535).
APP_PORT=8765

# Optional: absolute path, default $COMMONPLACE_ROOT/compose.yml.
COMPOSE_FILE=/srv/commonplace/compose.yml

# Optional: absolute path, default $COMMONPLACE_ROOT/.env.
COMPOSE_ENV_FILE=/srv/commonplace/.env

# Required: absolute path to the staged release source.
COMMONPLACE_SOURCE_DIR=/srv/commonplace/app

# Required: absolute path to the application environment file.
COMMONPLACE_ENV_FILE=/srv/commonplace/.env

# Required: absolute path to persistent data.
COMMONPLACE_DATA_DIR=/srv/commonplace/data

