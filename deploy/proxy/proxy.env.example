# Proxy environment file — copy to /etc/mempalace/proxy.env and edit.
# Keep this file readable only by the service account: chmod 600.

# MemPalace server endpoint (the --transport http address)
UPSTREAM_URL=http://127.0.0.1:8765/mcp

# Bearer token — must match MEMPALACE_MCP_HTTP_TOKEN on the server.
# Leave empty if the server has no token configured.
# UPSTREAM_TOKEN=

# Proxy bind address
HOST=127.0.0.1
PORT=8766

# Tuning
UPSTREAM_TIMEOUT=120
MAX_RETRIES=2
SESSION_TTL=1800
LOG_LEVEL=INFO
